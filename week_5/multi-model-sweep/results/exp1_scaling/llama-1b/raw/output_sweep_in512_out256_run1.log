def bubble_sort(numbers):
    """
    Sorts a list of numbers using the bubble sort algorithm.

    Args:
        numbers (list): A list of numbers to be sorted.

    Returns:
        list: The sorted list of numbers.
    """
    # Check if the input list is empty or contains only one element
    if len(numbers) < 2:
        return numbers

    # Initialize a flag to track if any swaps were made in the current pass
    swapped = True

    # Continue iterating until no swaps are needed (i.e., the list is sorted)
    while swapped:
        swapped = False

        # Iterate through the list, comparing each pair of adjacent elements
        for i in range(len(numbers) - 1):
            # If the current element is greater than the next one, swap them
